{
  "mcpServers": {
    "adguard-home-agent": {
      "command": "uv",
      "args": [
        "run",
        "adguard-mcp"
      ],
      "env": {
        "ADGUARD_PASSWORD": "<YOUR_ADGUARD_PASSWORD>",
        "ADGUARD_URL": "<YOUR_ADGUARD_URL>",
        "ADGUARD_USERNAME": "<YOUR_ADGUARD_USERNAME>",
        "ACCESSTOOL": "True",
        "AGENT_DESCRIPTION": "<YOUR_AGENT_DESCRIPTION>",
        "AGENT_SYSTEM_PROMPT": "<YOUR_AGENT_SYSTEM_PROMPT>",
        "BLOCKED_SERVICESTOOL": "True",
        "CLIENTSTOOL": "True",
        "DEFAULT_AGENT_NAME": "<YOUR_DEFAULT_AGENT_NAME>",
        "DHCPTOOL": "True",
        "DNSTOOL": "True",
        "FILTERINGTOOL": "True",
        "MISCTOOL": "True",
        "MOBILETOOL": "True",
        "PROFILETOOL": "True",
        "QUERY_LOGTOOL": "True",
        "REWRITESTOOL": "True",
        "SETTINGSTOOL": "True",
        "STATSTOOL": "True",
        "SYSTEMTOOL": "True",
        "TLSTOOL": "True"
      }
    }
  }
}
